<?xml version="1.0" encoding="utf-8"?>
<!-- 「杂项设置」面板：不属于任何主题域的开关。外层 ScrollView 与其它面板一致
     （车机侧内容区只有约 200dp 高，必须能滚动）。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="14dp"
        android:paddingRight="13dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="上车自动连接"
            android:textColor="#FFF5F5F7"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_segment"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/btnAutoConnectOn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_segment_sel"
                android:paddingLeft="18dp"
                android:paddingTop="6dp"
                android:paddingRight="18dp"
                android:paddingBottom="6dp"
                android:text="开"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnAutoConnectOff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:paddingLeft="18dp"
                android:paddingTop="6dp"
                android:paddingRight="18dp"
                android:paddingBottom="6dp"
                android:text="关"
                android:textColor="#FF8E8E93"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/autoConnectNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="车机蓝牙连上时自动拉起会话（需 Shizuku 已启动）。需要「显示在其他应用上层」权限才能在后台启动；该权限缺失时会自动补授。"
            android:textColor="#FF8E8E93"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="HID 原始日志"
            android:textColor="#FFF5F5F7"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_segment"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/btnHidRawOn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_segment_sel"
                android:paddingLeft="18dp"
                android:paddingTop="6dp"
                android:paddingRight="18dp"
                android:paddingBottom="6dp"
                android:text="开"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnHidRawOff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:paddingLeft="18dp"
                android:paddingTop="6dp"
                android:paddingRight="18dp"
                android:paddingBottom="6dp"
                android:text="关"
                android:textColor="#FF8E8E93"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/hidRawNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="键位校准用：打开后每帧 HID 报文写一行 HID-RAW（uuid + hex 字节），对照按下方向盘/旋钮时打印的字节调整键位映射。平时请关闭，避免日志刷屏。"
            android:textColor="#FF8E8E93"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="完整触摸日志"
            android:textColor="#FFF5F5F7"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_segment"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/btnTouchFullOn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_segment"
                android:paddingLeft="18dp"
                android:paddingTop="6dp"
                android:paddingRight="18dp"
                android:paddingBottom="6dp"
                android:text="开"
                android:textColor="#FF8E8E93"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnTouchFullOff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:background="@drawable/bg_segment_sel"
                android:paddingLeft="18dp"
                android:paddingTop="6dp"
                android:paddingRight="18dp"
                android:paddingBottom="6dp"
                android:text="关"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/touchFullNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="调试车机触摸用：打开后逐条打印触点坐标与注入结果；默认关（只出每 5 秒一条的汇总计数，无坐标），避免连续触摸时日志刷屏。"
            android:textColor="#FF8E8E93"
            android:textSize="12sp" />

        <!-- 触摸注入节流（2026-11-18 自「显示」面板移入）：调试调优类，与触摸日志相邻 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="触摸注入节流"
            android:textColor="#FFF5F5F7"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <SeekBar
                android:id="@+id/throttleSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="6" />

            <TextView
                android:id="@+id/throttleValue"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:gravity="right"
                android:textColor="#FF8E8E93"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="交互滞后但帧率正常（事件派发堆积）时调高试验；拖动即时生效"
            android:textColor="#FF8E8E93"
            android:textSize="12sp" />

<TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="音频路由自愈"
            android:textColor="#FFF5F5F7"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_segment"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/btnAudioReclaimOn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_segment_sel"
                android:paddingLeft="18dp"
                android:paddingTop="6dp"
                android:paddingRight="18dp"
                android:paddingBottom="6dp"
                android:text="开"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnAudioReclaimOff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:paddingLeft="18dp"
                android:paddingTop="6dp"
                android:paddingRight="18dp"
                android:paddingBottom="6dp"
                android:text="关"
                android:textColor="#FF8E8E93"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="连接期间检测到媒体输出被蓝牙设备抢走（耳机回连等，车机侧会变无声）时，自动断开该设备恢复声音。"
            android:textColor="#FF8E8E93"
            android:textSize="12sp" />

        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="断开保留虚拟屏"
            android:textColor="#FFF5F5F7"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_segment"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/btnKeepDisplaysOn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_segment_sel"
                    android:paddingLeft="18dp"
                    android:paddingTop="6dp"
                    android:paddingRight="18dp"
                    android:paddingBottom="6dp"
                    android:text="开"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnKeepDisplaysOff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:paddingLeft="18dp"
                    android:paddingTop="6dp"
                    android:paddingRight="18dp"
                    android:paddingBottom="6dp"
                    android:text="关"
                    android:textColor="#FF8E8E93"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/retentionRetriesLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="14dp"
                android:text="重试窗口"
                android:textColor="#FF8E8E93"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/retentionRetriesSeek"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="6dp"
                android:max="9" />

            <TextView
                android:id="@+id/retentionRetriesValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="6dp"
                android:textColor="#FF8E8E93"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/retentionNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="任何断开（手动/意外）后保留虚拟屏，屏上应用原样存活、页面状态分毫不动；重连成功即恢复原样。每 60s 一个重试窗口，连续 N 窗未恢复则销毁（屏上应用自动挪回手机继续运行）。重装 CarDeck 后重进也能按快照复用。"
            android:textColor="#FF8E8E93"
            android:textSize="12sp" />

        <!-- 断开后保留活动应用横屏（2026-11-19）：teardown 复原跳过活进程，
             避免 am compat disable 杀掉正在导航的应用 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="断开后保留应用横屏"
            android:textColor="#FFF5F5F7"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_segment"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/btnKeepOriOn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_segment_sel"
                android:paddingLeft="18dp"
                android:paddingTop="6dp"
                android:paddingRight="18dp"
                android:paddingBottom="6dp"
                android:text="开"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnKeepOriOff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:background="@drawable/bg_segment"
                android:paddingLeft="18dp"
                android:paddingTop="6dp"
                android:paddingRight="18dp"
                android:paddingBottom="6dp"
                android:text="关"
                android:textColor="#FF8E8E93"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/keepOriNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="断开会话时，屏上应用（如导航）会自动挪回手机继续运行——不退出、页面状态保留，名单内应用不撤销横屏覆盖、不重启；已退出的应用照常复原。在「管理桌面应用」里手动关闭某应用横屏仍会立即生效（应用会重启）。"
            android:textColor="#FF8E8E93"
            android:textSize="12sp" />

        <!-- 音频采集首选链路（2026-11-20）：播放捕获（默认，0.1.10 真车有声形态）
             ↔ REMOTE_SUBMIX（shell 管道直采）；首选不可用自动落另一条，下次连接生效 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="音频采集首选链路"
            android:textColor="#FFF5F5F7"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_segment"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/btnAudioCapProjection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_segment_sel"
                android:paddingLeft="18dp"
                android:paddingTop="6dp"
                android:paddingRight="18dp"
                android:paddingBottom="6dp"
                android:text="播放捕获"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnAudioCapSubmix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:background="@drawable/bg_segment"
                android:paddingLeft="18dp"
                android:paddingTop="6dp"
                android:paddingRight="18dp"
                android:paddingBottom="6dp"
                android:text="REMOTE_SUBMIX"
                android:textColor="#FF8E8E93"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/audioCapNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="播放捕获（默认）：走 MediaProjection 投屏授权。REMOTE_SUBMIX：shell 管道直采（需 Shizuku 在场），会接管手机媒体路由、手机本地静音。首选不可用时自动落到另一条；下次连接生效。"
            android:textColor="#FF8E8E93"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
