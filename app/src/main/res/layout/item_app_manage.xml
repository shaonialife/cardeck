<?xml version="1.0" encoding="utf-8"?>
<!-- 设置页「管理桌面应用」行：图标 + 名称（下方可带横屏状态小字）+ 双勾选框
     （左=应用横屏，右=桌面显示；表头列文案见 fragment_panel_desktop 的对齐注释） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="4dp"
    android:layout_marginRight="4dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_app_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="8dp"
    android:paddingTop="7dp"
    android:paddingRight="8dp"
    android:paddingBottom="7dp">

    <ImageView
        android:id="@+id/manageIcon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/manageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFF5F5F7"
            android:textSize="13sp" />

        <!-- 横屏系统侧覆盖状态小字：默认隐藏；残留（勾选框关但系统开）时红色高亮可点清除 -->
        <TextView
            android:id="@+id/manageHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFF6B6B"
            android:textSize="10.5sp"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/manageOriCheck"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginRight="14dp"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/manageDesktopCheck"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no" />
</LinearLayout>
